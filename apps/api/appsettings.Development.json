{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=socialops;Username=postgres;Password=password"
  },
  "Outbound": {
    "UseSandbox": true
  },
  "Webhooks": {
    "EnableSandbox": true
  },
  "Database": {
    "SeedDevelopmentData": true
  },
  "DevelopmentData": {
    "EnableReset": true
  },
  "Agent": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 30,
    "Retry": {
      "MaxAttempts": 2,
      "BaseDelayMilliseconds": 250
    }
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "SocialOps",
      "Audience": "SocialOps.Web",
      "SigningKey": "development-only-socialops-signing-key-change-in-production",
      "AccessTokenMinutes": 60
    },
    "ApiKey": {
      "HeaderName": "X-Api-Key",
      "Keys": [
        {
          "Key": "dev-agent-key",
          "OrganizationId": "00000000-0000-0000-0000-000000000001",
          "Role": "Agent",
          "Name": "Development Agent Service"
        }
      ]
    }
  }
}
