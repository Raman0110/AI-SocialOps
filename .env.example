# Copy to .env (git-ignored) and fill in. Used by docker compose.

# Required for the agent to answer (https://console.groq.com)
GROQ_API_KEY=

# Optional overrides for the local stack
POSTGRES_PASSWORD=socialops
SOCIALOPS_API_KEY=dev-api-key

# Real Instagram, leave blank to use the sandbox (see docs/INSTAGRAM_SETUP.md)
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
